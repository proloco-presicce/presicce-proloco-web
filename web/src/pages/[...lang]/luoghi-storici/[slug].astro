---
import Base from '../../../layouts/Base.astro';
import Accent from '../../../components/Accent.astro';
import Gallery from '../../../components/Gallery.astro';
import PageHero from '../../../components/PageHero.astro';
import { langParam, locales, path, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { Image as Picture } from 'astro:assets';
import { fotoTappa } from '../../../lib/foto';
import { telHref, mapsHref, accentLast } from '../../../lib/format';
import { getImpostazioni, getStazioni, image, isFallback, markdown, pick, type Image, type Stazione } from '../../../lib/content';

export async function getStaticPaths() {
  const stazioni = await getStazioni();
  return locales.flatMap((locale) =>
    stazioni.map((stazione, i) => ({
      params: { lang: langParam(locale), slug: stazione.slug.current },
      props: { locale, stazione, prev: stazioni[i - 1] ?? null, next: stazioni[i + 1] ?? null },
    })),
  );
}

const { locale, stazione, prev, next } = Astro.props as { locale: Locale; stazione: Stazione; prev: Stazione | null; next: Stazione | null };
const tr = t(locale);
const total = (await getStazioni()).length;
const impostazioni = await getImpostazioni();
const titolo = pick(stazione.titolo, locale);
const epoca = pick(stazione.epoca, locale);
const cosaGuardare = (stazione.cosaGuardare ?? []).map((c) => pick(c, locale)).filter(Boolean);
const stepOf = tr('stepOf').replace('{i}', String(stazione.ordine)).replace('{n}', String(total));
const local = fotoTappa[stazione.slug.current];
const imagesAll = (stazione.immagini ?? []).map((i) => image(i, locale)).filter((i): i is Image => !!i);
const images = local ? imagesAll : imagesAll.slice(1);
const cover = local ? null : imagesAll[0] ?? null;
---

<Base locale={locale} title={titolo} description={pick(stazione.sottotitolo, locale)} image={imagesAll[0]?.src} autoTranslated={isFallback(stazione.testo, locale)}>
  <PageHero slot="hero" title={accentLast(titolo, locale)} eyebrow={tr('navPlaces')} intro={pick(stazione.sottotitolo, locale)}>
    <div slot="before-title" class="progress">
      <span class="dots" role="img" aria-label={stepOf}>
        {Array.from({ length: total }, (_, i) => <span class:list={['dot', { on: i + 1 === stazione.ordine }]} />)}
      </span>
      <span class="count" aria-hidden="true">{stepOf}</span>
    </div>
  </PageHero>

  {(local || cover) && (
    <figure class="cover">
      <span class="arch">
        {local ? (
          <Picture src={local} alt={titolo} widths={[480, 900, 1400]} sizes="(min-width: 48rem) 46rem, 100vw" fetchpriority="high" loading="eager" />
        ) : (
          cover && <img src={cover.src} alt={cover.alt || titolo} width="1200" height="900" fetchpriority="high" />
        )}
      </span>
      {cover?.caption && <figcaption>{cover.caption}</figcaption>}
    </figure>
  )}

  <section class="facts">
    {epoca && <div class="fact"><span>{tr('era')}</span><b>{epoca}</b></div>}
    {stazione.indirizzo && <div class="fact"><span>{tr('where')}</span><b>{stazione.indirizzo}</b></div>}
    <a class="btn secondary map" href={mapsHref(stazione.indirizzo || titolo)} rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
      {tr('openMap')}
    </a>
  </section>

  <section class="block">
    <div class="prose story" set:html={markdown(stazione.testo, locale)} />
    {cosaGuardare.length > 0 && (
      <div class="look">
        <span class="look-title">{tr('lookFor')}</span>
        <ul>{cosaGuardare.map((c) => <li>{c}</li>)}</ul>
      </div>
    )}
    <Gallery images={images} />
  </section>

  <nav class="pager" aria-label={tr('stops')}>
    {prev ? (
      <a rel="prev" href={path(locale, `/luoghi-storici/${prev.slug.current}/`)}><span class="p-small"><span class="arrow">←</span> {tr('stepN').replace('{i}', String(prev.ordine))}</span><span class="p-big">{pick(prev.titolo, locale)}</span></a>
    ) : (
      <a href={path(locale, '/luoghi-storici/')}><span class="p-small"><span class="arrow">←</span> {tr('back')}</span><span class="p-big">{tr('allPlaces')}</span></a>
    )}
    {next ? (
      <a class="next" rel="next" href={path(locale, `/luoghi-storici/${next.slug.current}/`)}><span class="p-small">{tr('stepN').replace('{i}', String(next.ordine))} <span class="arrow">→</span></span><span class="p-big">{pick(next.titolo, locale)}</span></a>
    ) : (
      <a class="next" href={path(locale, '/luoghi-storici/')}><span class="p-small">{tr('navPlaces')} <span class="arrow">→</span></span><span class="p-big">{tr('allPlaces')}</span></a>
    )}
  </nav>

  {impostazioni.telefono && (
    <section class="guide-cta">
      <h2><Accent text={tr('guideCta')} /></h2>
      <p>{tr('guideCtaText')}</p>
      <a class="btn" href={telHref(impostazioni.telefono)}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>
        {tr('callToBook')}
      </a>
    </section>
  )}
</Base>

<style>
  .progress { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .dots { display: flex; align-items: center; gap: 7px; }
  .dot { width: 10px; height: 10px; border-radius: var(--r-pill); background: color-mix(in srgb, var(--light) 28%, transparent); }
  .dot.on { width: 14px; height: 14px; background: var(--gold); box-shadow: var(--shadow-bulb); }
  .count { font-size: 15px; font-weight: 800; color: var(--light); }

  .cover { margin: 0; max-width: 46rem; }
  .cover .arch { display: block; padding: 4px; border: var(--dots-thin) var(--bulb); border-radius: var(--r-pill) var(--r-pill) var(--r-md) var(--r-md); }
  .cover img { display: block; width: 100%; height: clamp(320px, 80vw, 520px); object-fit: cover; border-radius: var(--r-pill) var(--r-pill) var(--r-md) var(--r-md); background: var(--ph); }
  figcaption { color: var(--muted); font-size: 0.9rem; margin-block-start: 0.5rem; }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-block-start: 20px; max-width: 46rem; }
  .fact { display: flex; flex-direction: column; gap: 2px; padding: 14px; border-radius: var(--r-md); background: var(--surface); border: 2px solid var(--ink); box-shadow: var(--hard-sm) var(--red); }
  .fact + .fact { box-shadow: var(--hard-sm) var(--ink); }
  .fact span { font-size: 12px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--red); font-family: var(--sans); }
  .fact b { font-size: 17px; line-height: 1.25; }
  .map { grid-column: 1 / -1; min-height: 48px; font-size: 16px; }

  .block { display: flex; flex-direction: column; gap: 14px; margin-block-start: 36px; }
  /* I titoli scritti nel testo ("La storia", "Curiosità"...) prendono lo stile dei titoli di sezione. */
  .story :global(h2) { display: flex; align-items: center; gap: 12px; font-size: 30px; margin-block: 1.2em 0.5em; }
  .story :global(h2:first-child) { margin-block-start: 0; }
  .story :global(h2)::after { content: ''; flex: 1; min-width: 2rem; border-top: var(--dots) var(--bulb); }
  .look { margin-block-start: 6px; padding: 18px; border-radius: var(--r-md); background: var(--surface); border: 2px solid var(--ink); box-shadow: var(--hard-sm) var(--red); display: flex; flex-direction: column; gap: 10px; max-width: 42rem; }
  .look-title { font-size: 13px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); font-family: var(--sans); }
  .look ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; font-weight: 700; }
  .look li { display: flex; gap: 12px; align-items: center; }
  .look li::before { content: ''; flex: 0 0 12px; height: 12px; border-radius: var(--r-pill); background: var(--gold); border: 3px solid var(--red); }

  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-block-start: 32px; max-width: 46rem; }
  .pager a { display: flex; flex-direction: column; justify-content: center; min-height: 72px; padding: 10px 16px; border-radius: var(--r-md); border: 2px solid var(--ink); background: var(--surface); color: var(--ink); text-decoration: none; }
  .pager a.next { background: var(--red); color: var(--white); box-shadow: var(--hard-sm) var(--ink); }
  .p-small { font-size: 13px; font-weight: 700; color: var(--muted); }
  .next .p-small { color: var(--on-red-soft); }
  .p-big { font-weight: 800; line-height: 1.2; font-family: var(--sans); }
  :global([dir='rtl']) .arrow { display: inline-block; transform: scaleX(-1); }

  .guide-cta {
    display: flex; flex-direction: column; gap: 12px; margin: 40px calc(16px - var(--gutter)) 0; padding: 26px 22px; border-radius: var(--r-lg); color: var(--white); max-width: 46rem;
    background: radial-gradient(70% 70% at 50% 20%, var(--glow-warm) 0%, var(--glow-warm-0) 70%), var(--grad-night);
    outline: var(--dots-thin) var(--gold); outline-offset: -10px;
  }
  .guide-cta h2 { font-size: 28px; line-height: 1.05; letter-spacing: -0.03em; }
  .guide-cta h2 :global(.it) { color: var(--light); }
  .guide-cta p { margin: 0; color: var(--on-dark); }
  .guide-cta .btn { background: var(--white); color: var(--red); }
  @media (min-width: 48rem) { .guide-cta { margin-inline: 0; padding: 36px; } }
</style>
