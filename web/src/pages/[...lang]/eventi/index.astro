---
import Base from '../../../layouts/Base.astro';
import Accent from '../../../components/Accent.astro';
import EventCard from '../../../components/EventCard.astro';
import { localePaths, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { getEventi, splitEventi } from '../../../lib/content';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const tr = t(locale);
const { prossimi, passati } = splitEventi(await getEventi());
---

<Base locale={locale} title={tr('navEvents')}>
  <div class="section-title"><h1><Accent text={tr('homeEvents')} /></h1><span class="bulbs" aria-hidden="true"></span></div>
  <h2 class="sub">{tr('upcomingEvents')}</h2>
  {prossimi.length ? <div class="cards">{prossimi.map((evento) => <EventCard evento={evento} locale={locale} />)}</div> : <p class="empty">{tr('noEvents')}</p>}

  {
    passati.length > 0 && (
      <>
        <h2 class="sub">{tr('pastEvents')}</h2>
        <div class="cards past">{passati.map((evento) => <EventCard evento={evento} locale={locale} />)}</div>
      </>
    )
  }
</Base>

<style>
  .sub { font-size: 22px; letter-spacing: var(--track); margin-block: 32px 16px; }
  .past { opacity: 0.7; }
</style>
