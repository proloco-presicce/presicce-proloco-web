---
import Base from '../../../layouts/Base.astro';
import Accent from '../../../components/Accent.astro';
import BookingButtons from '../../../components/BookingButtons.astro';
import EventCard from '../../../components/EventCard.astro';
import Gallery from '../../../components/Gallery.astro';
import { langParam, locales, path, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { getEventi, getImpostazioni, image, isFallback, markdown, pick, splitEventi, type Evento, type Image } from '../../../lib/content';
import { accentLast, calendarHref, dateBadge, formatDate, formatTime, weekday } from '../../../lib/format';

export async function getStaticPaths() {
  const eventi = await getEventi();
  return locales.flatMap((locale) => eventi.map((evento) => ({ params: { lang: langParam(locale), slug: evento.slug.current }, props: { locale, evento } })));
}

const { locale, evento } = Astro.props as { locale: Locale; evento: Evento };
const tr = t(locale);
const impostazioni = await getImpostazioni();
const titolo = pick(evento.titolo, locale);
const img = image(evento.immagine, locale, 1200);
const descrizione = pick(evento.descrizione, locale);
const sommario = pick(evento.sommario, locale);
const badge = dateBadge(evento.dataInizio, locale);
const ora = formatTime(evento.dataInizio, locale);
const quando = formatDate(evento.dataInizio, locale).replace(/\s\d{4}$/, '') + (evento.dataFine ? ` – ${formatDate(evento.dataFine, locale)}` : '');
const foto = (evento.foto ?? []).map((i) => image(i, locale)).filter((i): i is Image => !!i);
const altri = splitEventi(await getEventi()).prossimi.filter((e) => e._id !== evento._id).slice(0, 2);
const phone = evento.telefono || impostazioni.telefono;
const whatsapp = evento.whatsapp || impostazioni.whatsapp;

// Dati strutturati schema.org: aiutano Google a mostrare l'evento nei risultati.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: titolo,
  startDate: evento.dataInizio,
  endDate: evento.dataFine,
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: evento.luogo ?? 'Presicce', address: evento.luogo ?? 'Presicce (LE), Italia' },
  image: img?.src,
  description: descrizione.slice(0, 300),
  organizer: { '@type': 'Organization', name: 'Pro Loco Presicce', url: 'https://presicceproloco.org' },
};
---

<Base
  locale={locale}
  title={titolo}
  description={(sommario || descrizione).slice(0, 160)}
  image={img?.src}
  autoTranslated={isFallback(evento.descrizione, locale)}
  back={{ href: path(locale, '/eventi/'), label: tr('navEvents') }}
>
  <div slot="hero" class="event-hero wrap">
    <div class="poster-wrap">
      <span class="arch">{img ? <img src={img.src} alt={img.alt || titolo} width="1200" height="1600" fetchpriority="high" /> : <span class="no-img" />}</span>
      <span class="sticker" aria-hidden="true"><span class="s-label">{weekday(evento.dataInizio, locale)}</span><span class="s-day">{badge.day}</span><span class="s-month">{badge.month.replace('.', '')}</span></span>
    </div>
    <div class="head">
      {evento.tipo && <span class="chip">{tr(`tipo_${evento.tipo}`)}</span>}
      <h1><Accent text={accentLast(titolo, locale)} /></h1>
      {sommario && <p class="intro">{sommario}</p>}
    </div>
  </div>

  <section class="facts">
    <div class="fact"><span>{tr('when')}</span><b>{quando}</b></div>
    {ora && <div class="fact"><span>{tr('time')}</span><b>{ora}</b></div>}
    {evento.luogo && <div class="fact"><span>{tr('where')}</span><b>{evento.luogo}</b></div>}
  </section>

  {descrizione && (
    <section class="block">
      <div class="section-title"><h2><Accent text={tr('program')} /></h2><span class="bulbs" aria-hidden="true"></span></div>
      <div class="prose program" set:html={markdown(evento.descrizione, locale)} />
      <a class="btn secondary cal" href={calendarHref(titolo, evento.dataInizio, evento.dataFine, evento.luogo)} rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5" /></svg>
        {tr('addToCalendar')}
      </a>
    </section>
  )}

  {foto.length > 0 && (
    <section class="block">
      <div class="section-title"><h2><Accent text={tr('photos')} /></h2><span class="bulbs" aria-hidden="true"></span></div>
      <Gallery images={foto} />
    </section>
  )}

  {(phone || whatsapp) && (
    <section class="book">
      <span class="eyebrow">{tr('booking')}</span>
      <h2><Accent text={tr('bookTitle')} /></h2>
      <p>{tr('bookText')}</p>
      <BookingButtons locale={locale} phone={phone} whatsapp={whatsapp} tone="night" />
    </section>
  )}

  {altri.length > 0 && (
    <section class="block">
      <div class="section-title"><h2><Accent text={tr('otherEvents')} /></h2><span class="bulbs" aria-hidden="true"></span></div>
      <div class="cards">{altri.map((e) => <EventCard evento={e} locale={locale} />)}</div>
      <a class="more" href={path(locale, '/eventi/')}>{tr('calendar')} <span class="arrow" aria-hidden="true">→</span></a>
    </section>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  .event-hero { display: flex; flex-direction: column; gap: 16px; padding-block-start: 16px; }
  .poster-wrap { position: relative; padding-inline: 24px; max-width: 26rem; width: 100%; margin-inline: auto; }
  .arch { display: block; padding: 5px; border: var(--dots-thin) var(--gold); border-radius: var(--r-pill) var(--r-pill) var(--r-md) var(--r-md); }
  .arch img, .no-img { display: block; width: 100%; height: 300px; object-fit: cover; border-radius: var(--r-pill) var(--r-pill) var(--r-sm) var(--r-sm); background: color-mix(in srgb, var(--light) 8%, transparent); }
  .sticker {
    position: absolute; inset-inline-end: 2px; bottom: -18px; width: 78px; height: 78px; border-radius: var(--r-pill);
    display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.05; text-align: center;
    background: var(--white); color: var(--red); font-weight: 800; text-transform: uppercase; transform: rotate(10deg); box-shadow: var(--shadow-float);
    font-family: var(--sans);
  }
  :global([dir='rtl']) .sticker { transform: rotate(-10deg); }
  .s-label { font-size: 9px; max-width: 64px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .s-day { font-size: 26px; line-height: 1; font-family: var(--font-brand); }
  .s-month { font-size: 12px; }
  .head { display: flex; flex-direction: column; gap: 10px; padding-block-start: 10px; }
  .chip { align-self: flex-start; display: inline-flex; align-items: center; min-height: 28px; padding-inline: 12px; border-radius: var(--r-pill); background: var(--white); color: var(--red); font-size: 13px; font-weight: 800; }
  h1 { font-size: clamp(2.6rem, 13vw, 4.2rem); line-height: 0.95; letter-spacing: var(--track-display); overflow-wrap: anywhere; }
  h1 :global(.it) { color: var(--light); }
  :global(:root:is(:lang(ar), :lang(zh), :lang(ja))) h1 { letter-spacing: 0; line-height: 1.25; font-size: clamp(2.1rem, 10vw, 3.4rem); }
  .intro { margin: 0; font-size: 17px; line-height: 1.4; color: var(--on-dark); max-width: 38rem; }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .fact { display: flex; flex-direction: column; gap: 2px; padding: 14px; border-radius: var(--r-md); background: var(--surface); border: 2px solid var(--ink); box-shadow: var(--hard-sm) var(--ink); }
  .fact:first-child, .fact:nth-child(4) { box-shadow: var(--hard-sm) var(--red); }
  .fact:first-child { grid-column: 1 / -1; }
  .fact span { font-size: 12px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--red); font-family: var(--sans); }
  .fact b { font-size: 17px; line-height: 1.25; }
  .fact b::first-letter { text-transform: uppercase; }

  .block { display: flex; flex-direction: column; gap: 16px; margin-block-start: 36px; }
  .section-title h2 { font-size: 30px; }
  .cal { min-height: 48px; font-size: 16px; }
  .more { align-self: center; min-height: var(--tap); display: inline-flex; align-items: center; gap: 6px; font-weight: 800; }
  :global([dir='rtl']) .arrow { display: inline-block; transform: scaleX(-1); }

  /* Gli elenchi della descrizione diventano le tappe della giornata, con le lampadine. */
  .program :global(ul), .program :global(ol) { position: relative; list-style: none; margin: 0 0 1em; padding: 0; }
  .program :global(ul)::before, .program :global(ol)::before { content: ''; position: absolute; inset-inline-start: 9px; top: 14px; bottom: 14px; border-inline-start: var(--dots-thin) var(--bulb); }
  .program :global(li) { position: relative; padding-block-end: 18px; padding-inline-start: 34px; }
  .program :global(li:last-child) { padding-block-end: 0; }
  .program :global(li)::before {
    content: ''; position: absolute; inset-inline-start: 0; top: 4px; width: 14px; height: 14px; border-radius: var(--r-pill);
    background: var(--gold); border: 3px solid var(--red); box-shadow: var(--shadow-bulb); box-sizing: content-box;
  }

  .book {
    display: flex; flex-direction: column; gap: 12px; margin: 40px calc(16px - var(--gutter)) 0; padding: 30px 22px 24px; border-radius: var(--r-lg); color: var(--white);
    background: radial-gradient(70% 60% at 50% 0%, var(--red-glow) 0%, transparent 70%), var(--grad-red);
    outline: var(--dots) var(--gold); outline-offset: -12px;
  }
  .book .eyebrow { color: var(--on-red-soft); margin: 0; }
  .book h2 { font-size: 30px; line-height: 1; letter-spacing: -0.03em; }
  .book h2 :global(.it) { color: var(--light); }
  .book p { margin: 0; color: var(--on-dark); }

  @media (min-width: 60rem) {
    .event-hero { display: grid; grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); align-items: end; gap: 48px; padding-block: 12px 10px; }
    .poster-wrap { padding: 0; margin: 0; }
    .arch img, .no-img { height: 420px; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 60rem; }
    .fact:first-child { grid-column: auto; }
    .block, .book { max-width: 48rem; }
    .book { margin-inline: 0; padding: 40px; }
  }
</style>
