---
// Layout di base con la grafica "Proposta E · Festa e luminarie": bianco e rosso, testata notturna
// con le luminarie, bordo a festoni, card con ombra piena. Pensato prima per lo smartphone.
// Usa solo proprietà CSS logiche (margin-inline, padding-block...) così l'arabo si gira da solo.
// Le pagine possono riempire lo slot "hero" per mettere qualcosa nella testata scura.
import { defaultLocale, htmlLang, localeNames, locales, path, rtlLocales, stripLocale, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import Accent from '../components/Accent.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getImpostazioni } from '../lib/content';
import { prettyPhone, telHref } from '../lib/format';
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo-proloco.png';
import { foto } from '../lib/foto';
import '../styles/tokens.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  image?: string;
  autoTranslated?: boolean;
  noindex?: boolean;
  /** Al posto del logo, un pulsante per tornare indietro (es. dalla scheda evento all'elenco). */
  back?: { href: string; label: string };
}

const { locale, title, description = '', image, autoTranslated = false, noindex = false, back } = Astro.props;
const tr = t(locale);
const impostazioni = await getImpostazioni();
const current = stripLocale(Astro.url.pathname);
const canonical = new URL(path(locale, current), Astro.site);
const fullTitle = title === tr('siteName') ? title : `${title} · ${tr('siteName')}`;
const nav = [
  { href: path(locale, '/'), label: tr('navHome') },
  { href: path(locale, '/eventi/'), label: tr('navEvents') },
  { href: path(locale, '/luoghi-storici/'), label: tr('navPlaces') },
  { href: '#contatti', label: tr('navContact') },
];
const hasHero = Astro.slots.has('hero');
// Da computer il menu sta tutto nella barra: Eventi, Luoghi storici, Visite guidate, Contatti.
const desktopNav = [nav[1], nav[2], { href: `${path(locale, '/')}#visite`, label: tr('toursEyebrow') }, nav[3]];
// Per le condivisioni sui social, se la pagina non ha una sua foto: la Chiesa Madre dall'alto.
const ogImage = image ?? new URL((await getImage({ src: foto.chiesaMadre, width: 1200, format: 'jpg' })).src, Astro.site).href;

// Bricolage Grotesque e Playfair Display non hanno greco, arabo, cinese e giapponese:
// per quelle lingue carichiamo anche un Noto che copre l'alfabeto (vedi le variabili --sans e --serif).
const scriptFonts: Partial<Record<Locale, string>> = {
  el: 'family=Noto+Sans:wght@500;700;800&family=Noto+Serif:ital,wght@1,500;1,600',
  ar: 'family=Noto+Kufi+Arabic:wght@500;700;800&family=Noto+Naskh+Arabic:wght@400;600',
  zh: 'family=Noto+Sans+SC:wght@500;700;800&family=Noto+Serif+SC:wght@500;600',
  ja: 'family=Noto+Sans+JP:wght@500;700;800&family=Noto+Serif+JP:wght@500;600',
};
const fonts = [
  'family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Playfair+Display:ital,wght@1,500;1,600',
  scriptFonts[locale],
].filter(Boolean).join('&');
---

<!doctype html>
<html lang={htmlLang[locale]} dir={rtlLocales.includes(locale) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(path(l, current), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path(defaultLocale, current), Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#1e0409" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
  </head>
  <body>
    <a class="skip" href="#main">{tr('skip')}</a>
    <div class:list={['night', { 'with-hero': hasHero }]}>
      <header class="bar wrap">
        {back ? (
          <a class="back" href={back.href}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            {back.label}
          </a>
        ) : (
          <a class="logo" href={path(locale, '/')}>
            <Image src={logo} alt={tr('siteName')} width={76} height={76} densities={[1, 2, 3]} loading="eager" />
          </a>
        )}
        <nav class="desk-nav" aria-label="Menu">
          {desktopNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="tools">
          {back && (
            <button type="button" class="share" aria-label={tr('share')} data-copied={tr('linkCopied')}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg>
            </button>
          )}
          <LanguageSwitcher locale={locale} />
          {impostazioni.telefono && (
            <a class="btn desk-call" href={telHref(impostazioni.telefono)}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>
              {tr('call')}
            </a>
          )}
          <details class="menu popover">
            <summary aria-label={tr('openMenu')}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 8h14M5 16h14" /></svg>
            </summary>
            <nav class="panel" aria-label="Menu">
              <ul>{nav.map((item) => <li><a href={item.href} aria-current={item.href === path(locale, current) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
            </nav>
          </details>
        </div>
      </header>
      <slot name="hero" />
    </div>
    <div class="scallop" aria-hidden="true"></div>

    <main id="main" class="wrap">
      {autoTranslated && tr('autoTranslated') && <p class="notice">{tr('autoTranslated')}</p>}
      <slot />
    </main>

    <footer class="site-footer" id="contatti">
      <div class="wrap">
        <span class="bulbs light" aria-hidden="true"></span>
        <div class="f-hello">
          <p class="hello"><Accent text={tr('footerHello')} /></p>
          <p class="footer-text">{tr('contactText')}</p>
        </div>
        <div class="f-contacts">
          {impostazioni.telefono && <a class="phone" href={telHref(impostazioni.telefono)}>{prettyPhone(impostazioni.telefono)}</a>}
          {impostazioni.email && <a class="mail" href={`mailto:${impostazioni.email}`}>{impostazioni.email}</a>}
          <ul class="footer-nav">{nav.slice(1, 3).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </div>
        <p class="small">
          © {new Date().getFullYear()} Pro Loco Presicce
          {locales.map((l) => <> · <a href={path(l, current)} hreflang={htmlLang[l]} lang={htmlLang[l]}>{localeNames[l]}</a></>)}
        </p>
      </div>
    </footer>

    <script>
      // I menu a tendina (lingua e menu) si chiudono toccando fuori o premendo Esc,
      // e ne resta aperto uno solo alla volta.
      const popovers = [...document.querySelectorAll<HTMLDetailsElement>('details.popover')];
      const closeAll = (except?: Element) => popovers.forEach((d) => d !== except && d.removeAttribute('open'));
      popovers.forEach((d) => d.addEventListener('toggle', () => d.open && closeAll(d)));
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element) || !e.target.closest('details.popover')) closeAll();
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && closeAll());
      document.querySelectorAll('.popover .panel a[href^="#"]').forEach((a) => a.addEventListener('click', () => closeAll()));

      // Condividi: sul telefono apre il menu di condivisione, altrimenti copia il link.
      document.querySelector<HTMLButtonElement>('.share')?.addEventListener('click', async (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const data = { title: document.title, url: location.href };
        if (navigator.share) return navigator.share(data).catch(() => {});
        await navigator.clipboard?.writeText(location.href);
        button.setAttribute('aria-label', button.dataset.copied ?? '');
        button.classList.add('done');
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color: var(--ink);
    background: var(--cream);
    font-family: var(--body, var(--sans));
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  :root:lang(ar) { font-size: 18px; line-height: 1.8; }
  :root:lang(ar) .it { font-weight: inherit; }

  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; width: 100%; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--red); }
  a:hover { color: var(--red-dark); }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  h1, h2, h3, .btn, strong, b, summary, .eyebrow, .card { font-family: var(--sans); }
  h1, h2, h3 { line-height: 1.1; font-weight: 800; letter-spacing: var(--track-tight); margin-block: 0; }
  h1 { font-size: clamp(2.4rem, 11vw, 4rem); line-height: var(--lh-display); }
  .it { font-family: var(--serif); font-style: var(--serif-style); font-weight: 500; letter-spacing: -0.01em; }
  :root:is(:lang(ar), :lang(zh), :lang(ja)) .it { letter-spacing: 0; }
  h1 .it, h2 .it { color: var(--red); }

  .wrap { width: 100%; max-width: 72rem; margin-inline: auto; padding-inline: var(--gutter); }
  .skip { position: absolute; inset-inline-start: -999px; z-index: 30; }
  .skip:focus { inset-inline-start: 1rem; top: 1rem; background: var(--surface); padding: 0.5rem 1rem; border-radius: var(--r-pill); }

  /* Testata notturna: dal buio al rosso, con un alone caldo dove stanno le luminarie. */
  .night {
    position: relative; color: var(--white); padding-block: 16px 22px;
    background: radial-gradient(70% 45% at 50% 30%, var(--glow-warm) 0%, var(--glow-warm-0) 70%), linear-gradient(180deg, var(--night) 0%, var(--night-mid) 40%, var(--red-deep) 100%);
  }
  .night:not(.with-hero) { background: linear-gradient(180deg, var(--night) 0%, var(--night-mid) 55%, var(--red-deep) 100%); padding-block-end: 14px; }
  .scallop { height: 22px; background: radial-gradient(circle at 11px 0, var(--red-deep) 11px, transparent 11.5px) 0 0 / 22px 22px repeat-x; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; position: relative; z-index: 20; }
  .back {
    display: flex; align-items: center; gap: 6px; min-height: var(--tap); padding-inline: 10px 16px; border-radius: var(--r-pill);
    background: var(--white); color: var(--red); font-weight: 800; font-size: 15px; text-decoration: none; font-family: var(--sans);
  }
  .back:hover { color: var(--red-dark); }
  [dir='rtl'] .back svg { transform: scaleX(-1); }
  .share {
    display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: var(--r-pill); cursor: pointer;
    border: 2px solid var(--on-dark-line); background: transparent; color: var(--white);
  }
  .share.done { background: var(--white); color: var(--red); }
  .desk-nav, .bar .desk-call { display: none; }
  .logo { display: block; width: 56px; height: 56px; border-radius: var(--r-pill); box-shadow: var(--shadow-logo); }
  .logo img { width: 100%; height: 100%; border-radius: var(--r-pill); }
  .tools { display: flex; gap: 8px; align-items: center; }
  .popover { position: relative; }
  .popover summary { list-style: none; cursor: pointer; }
  .popover summary::-webkit-details-marker { display: none; }
  .menu summary { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: var(--r-pill); background: var(--white); color: var(--red); }
  .popover .panel {
    position: absolute; inset-inline-end: 0; top: calc(100% + 8px); z-index: 20;
    background: var(--surface); border: 2px solid var(--ink); border-radius: var(--r-md); box-shadow: var(--hard-md) var(--red);
  }
  .menu .panel { min-width: 15rem; padding: 8px; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a { display: block; padding: 12px 16px; border-radius: var(--r-xs); color: var(--ink); text-decoration: none; font-weight: 800; font-size: 19px; letter-spacing: var(--track); }
  .menu a:hover { background: var(--ph); color: var(--ink); }
  .menu a[aria-current] { color: var(--red); }

  /* Elementi della grafica riusati nelle pagine */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 1.25rem;
    border-radius: var(--r-pill); font-weight: 800; font-size: 17px; text-decoration: none; text-align: center; line-height: 1.2;
    border: 2px solid transparent;
  }
  .btn.primary { background: var(--red); color: var(--white); }
  .btn.primary:hover { background: var(--red-dark); color: var(--white); }
  .btn.secondary { border-color: var(--ink); color: var(--ink); background: var(--surface); }
  .btn.outline { border-color: var(--ink); color: var(--ink); background: var(--surface); box-shadow: var(--hard-sm) var(--red); }
  .bulbs { display: block; height: 0; border-top: var(--dots) var(--bulb); }
  .bulbs.light { border-top-color: var(--light); }
  .section-title { display: flex; align-items: center; gap: 12px; }
  .section-title h2, .section-title h1 { font-size: clamp(2rem, 8.5vw, 2.6rem); line-height: 1; }
  .section-title .bulbs { flex: 1; min-width: 2rem; }
  .card {
    display: block; background: var(--surface); border: 2px solid var(--ink); border-radius: var(--r-lg); color: var(--ink); text-decoration: none;
    box-shadow: var(--hard-md) var(--red); transition: transform 0.15s, box-shadow 0.15s;
  }
  .cards { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); }
  .cards > :nth-child(even) { box-shadow: var(--hard-md) var(--ink); }
  a.card:hover { color: var(--ink); transform: translate(-2px, -2px); }
  .lead { color: var(--muted); font-size: 1.1rem; margin-block: 0.5rem 0; }
  .eyebrow { margin: 0 0 0.5rem; font-size: var(--fs-caps); font-weight: 800; letter-spacing: var(--track-caps); text-transform: uppercase; color: var(--red); }
  .eyebrow a { text-decoration: none; }
  .empty { padding: 1.25rem; border: 2px dashed var(--muted); border-radius: var(--r-md); color: var(--muted); }
  .prose { max-width: 42rem; }
  .prose img { border-radius: var(--r-md); }
  .notice { margin-block: 1.25rem 0; padding: 0.6rem 1rem; border-radius: var(--r-sm); background: var(--ph); color: var(--muted); font-size: 0.9rem; }

  main > :first-child:not(.notice), main > .notice + * { margin-block-start: 1.5rem; }

  .site-footer { margin-block-start: 3.5rem; padding-block: 30px 40px; background: var(--red); color: var(--white); }
  .site-footer .wrap { display: flex; flex-direction: column; gap: 8px; }
  .f-hello, .f-contacts { display: flex; flex-direction: column; gap: 8px; }
  .site-footer .bulbs { margin-block-end: 12px; }
  .site-footer a { color: var(--on-red-link); }
  .hello { margin: 0; font-size: 30px; line-height: 1.1; font-weight: 800; letter-spacing: var(--track-tight); }
  .footer-text { margin: 0 0 8px; color: var(--on-red-soft); max-width: 34rem; }
  .site-footer .phone { color: var(--white); font-size: 22px; font-weight: 800; text-decoration: none; direction: ltr; unicode-bidi: isolate; align-self: start; }
  .site-footer .mail { overflow-wrap: anywhere; }
  .footer-nav { display: flex; flex-wrap: wrap; gap: 4px 18px; list-style: none; margin: 8px 0 0; padding: 0; }
  .footer-nav a { display: inline-block; padding-block: 10px; font-weight: 700; }
  .small { margin: 0; font-size: 14px; color: var(--on-red-soft); }
  .small a { color: inherit; text-decoration: none; }
  .small a:hover { text-decoration: underline; }

  /* Da computer: menu nella barra, pulsante Chiama, footer su due colonne. */
  @media (min-width: 60rem) {
    .wrap { max-width: 1240px; }
    .night { padding-block-start: 20px; }
    .bar { gap: 14px 32px; }
    .logo { width: 76px; height: 76px; }
    .desk-nav { display: flex; flex-wrap: wrap; gap: 4px 32px; margin-inline-end: auto; margin-inline-start: 16px; }
    .desk-nav a { color: var(--white); text-decoration: none; font-weight: 800; font-size: 17px; padding: 10px 2px; font-family: var(--sans); }
    .desk-nav a:hover { color: var(--gold); }
    .bar .desk-call { display: inline-flex; min-height: 48px; padding-inline: 22px; background: var(--white); color: var(--red); font-size: 16px; }
    .desk-call:hover { color: var(--red-dark); }
    .menu { display: none; }
    .site-footer { margin-block-start: 96px; padding-block: 48px 40px; }
    .site-footer .wrap { flex-direction: row; flex-wrap: wrap; gap: 32px 64px; }
    .site-footer .bulbs { flex: 1 1 100%; border-top-width: 5px; margin: 0; }
    .f-hello { flex: 1 1 360px; }
    .f-contacts { flex: 1 1 300px; }
    .hello { font-size: clamp(36px, 4vw, 52px); line-height: 1; }
    .site-footer .phone { font-size: 30px; }
    .site-footer .small { flex: 1 1 100%; padding-block-start: 22px; border-top: 1px solid color-mix(in srgb, var(--white) 30%, transparent); font-size: 15px; }
  }
</style>
