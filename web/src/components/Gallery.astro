---
import type { Image } from '../lib/content';

interface Props {
  images: Image[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <div class="gallery">
      {images.map((img) => (
        <figure>
          <img src={img.src} alt={img.alt} loading="lazy" width="1200" height="900" />
          {img.caption && <figcaption>{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
}

<style>
  .gallery { margin-block: 2rem; display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  img { border-radius: 22px; border: 2px solid var(--ink); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--ph); }
  figure { margin: 0; }
  figcaption { color: var(--muted); font-size: 0.9rem; margin-block-start: 0.4rem; }
</style>
