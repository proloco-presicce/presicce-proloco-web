---
import { htmlLang, localeNames, locales, path, stripLocale, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const current = stripLocale(Astro.url.pathname);
---

<details class="lang popover">
  <summary aria-label={`${t(locale)('language')}: ${localeNames[locale]}`}>{locale.toUpperCase()}</summary>
  <ul class="panel">
    {
      locales.map((l) => (
        <li>
          <a href={path(l, current)} hreflang={htmlLang[l]} lang={htmlLang[l]} aria-current={l === locale ? 'true' : undefined}>
            {localeNames[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  summary {
    min-height: 44px; min-width: 44px; padding-inline: 16px; display: flex; align-items: center; justify-content: center;
    border-radius: 999px; border: 2px solid rgb(255 255 255 / 0.8); color: #fff; font-weight: 800; font-size: 15px;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
  }
  ul { list-style: none; margin: 0; padding: 8px; min-width: 11rem; }
  a { display: block; padding: 10px 14px; text-decoration: none; color: var(--ink); border-radius: 12px; font-weight: 700; }
  a:hover { background: var(--ph); color: var(--ink); }
  a[aria-current] { background: var(--red); color: #fff; }
</style>
