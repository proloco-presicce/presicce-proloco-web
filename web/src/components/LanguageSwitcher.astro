---
import { htmlLang, localeNames, locales, path, stripLocale, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const current = stripLocale(Astro.url.pathname);
---

<details class="lang">
  <summary aria-label={t(locale)('language')}>{localeNames[locale]}</summary>
  <ul>
    {
      locales.map((l) => (
        <li>
          <a href={path(l, current)} hreflang={htmlLang[l]} lang={htmlLang[l]} aria-current={l === locale ? 'true' : undefined}>
            {localeNames[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang { position: relative; }
  summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; padding-inline: 0.75rem; border: 1px solid #eadfcd; border-radius: 999px; }
  ul { position: absolute; inset-inline-end: 0; z-index: 10; list-style: none; margin: 0.25rem 0 0; padding: 0.5rem; background: var(--surface); border-radius: var(--radius); box-shadow: 0 6px 24px rgb(0 0 0 / 0.12); min-width: 10rem; }
  a { display: block; padding: 0.5rem 0.75rem; text-decoration: none; color: var(--text); border-radius: 8px; }
  a[aria-current] { background: #f1e7d6; font-weight: 600; }
</style>
