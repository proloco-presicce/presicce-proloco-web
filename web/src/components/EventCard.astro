---
// Card evento della proposta E: bollino ad arco con la data, titolo e giorno · luogo.
import { path, type Locale } from '../i18n/config';
import { pick, type Evento } from '../lib/content';
import { dateBadge, weekday } from '../lib/format';

interface Props {
  evento: Evento;
  locale: Locale;
}

const { evento, locale } = Astro.props;
const badge = dateBadge(evento.dataInizio, locale);
const details = [weekday(evento.dataInizio, locale), evento.luogo].filter(Boolean).join(' · ');
---

<a class="card event" href={path(locale, `/eventi/${evento.slug.current}/`)}>
  <span class="date"><span class="day">{badge.day}</span><span class="month">{badge.month.replace('.', '')}</span></span>
  <span class="text">
    <span class="title">{pick(evento.titolo, locale)}</span>
    {details && <span class="details">{details}</span>}
  </span>
</a>

<style>
  .event { display: flex; gap: 14px; align-items: center; padding: 14px; }
  .date {
    flex: 0 0 70px; height: 84px; border-radius: 999px 999px 14px 14px;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-block-end: 10px;
    color: #fff; background: linear-gradient(180deg, var(--bulb), #a10d25); font-weight: 800; line-height: 1;
  }
  .day { font-size: 28px; }
  .month { font-size: 11px; text-transform: uppercase; margin-block-start: 4px; }
  .text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .title { font-size: 22px; line-height: 1.1; font-weight: 800; letter-spacing: var(--track); overflow-wrap: anywhere; }
  .details { font-size: 15px; color: var(--muted); }
</style>
